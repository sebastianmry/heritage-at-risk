# Template for local secrets and paths. Copy to .env and fill in.
# The real .env is never committed, per .gitignore.

# Root for large raw data outside the repo.
DATA_DIR=

# OpenRouteService (routing in the app): https://account.heigit.org/signup
# Read by build_app.bat and injected into the APK as
# --dart-define=ORS_API_KEY (never in code or the repo).
OPENROUTESERVICE_API_KEY=

# MapTiler (basemap, dataviz-light/dark): https://cloud.maptiler.com/account/keys
# Injected by build_app.bat as --dart-define=MAPTILER_KEY. Required; the
# basemap has no keyless fallback.
MAPTILER_API_KEY=
