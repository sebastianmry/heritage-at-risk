# Vorlage fuer lokale Geheimnisse und Pfade. Kopieren nach .env und ausfuellen.
# Die echte .env wird per .gitignore nie committet.

# Wurzel fuer grosse Rohdaten ausserhalb des Repos.
DATA_DIR=

# OpenRouteService (Intra-Site-Routing der App): https://openrouteservice.org/sign-up
OPENROUTESERVICE_API_KEY=

# ACLED (Konflikt-Komponente, Research-Stufe): myACLED-Login (E-Mail + Passwort).
# Nur akademische Nutzung, Repo bleibt privat. https://acleddata.com/register/
ACLED_API_EMAIL=
ACLED_API_PASSWORD=
