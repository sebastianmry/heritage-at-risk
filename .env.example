# Vorlage fuer lokale Geheimnisse und Pfade. Kopieren nach .env und ausfuellen.
# Die echte .env wird per .gitignore nie committet.

# Wurzel fuer grosse Rohdaten ausserhalb des Repos.
DATA_DIR=

# OpenRouteService (Routing der App): https://account.heigit.org/signup
# Wird von build_app.bat gelesen und als --dart-define=ORS_API_KEY in die APK
# injiziert (nie im Code oder Repo).
OPENROUTESERVICE_API_KEY=

# MapTiler (Hintergrundkarte dataviz-light): https://cloud.maptiler.com/account/keys
# Wird von build_app.bat als --dart-define=MAPTILER_KEY injiziert. Leer = die App
# faellt auf die keyless CARTO-Positron-Basemap zurueck.
MAPTILER_API_KEY=
