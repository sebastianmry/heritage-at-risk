# ignore-all-then-un-ignore
# Ignores everything first, then allows specific paths back in. Prevents raw
# data or secrets from being checked in by accident.

# --- ignore everything ---
*

# --- re-enter directories ---
!*/

# --- allow code and configuration ---
!*.py
!*.md
!*.txt
!*.toml
!*.cfg
!*.yml
!*.yaml
!.gitignore
!.gitattributes
!.env.example
# Build helper (reads the ORS key from the local .env, carries no secret itself).
!build_app.bat

# --- allow committed runtime artefacts ---
!artifacts/
!artifacts/**

# --- allow committed, curated reference lists ---
!reference/
!reference/**

# --- allow committed app screenshots (README/submission PDF) ---
!screenshots/
!screenshots/**

# --- allow Flutter/Android app sources (app/) ---
!*.dart
!*.lock
!*.gradle
!*.kts
!*.xml
!*.json
!*.png
!*.jar
!*.properties
!app/assets/**

# --- never: raw data, caches, secrets, build output ---
heritage_data/
.env
*.duckdb
*.pbf
*.parquet
__pycache__/
.venv/
.ipynb_checkpoints/

# --- never: local editor/Claude configuration ---
.claude/

# --- never: generated/local Flutter/Android artefacts ---
app/build/
app/.dart_tool/
app/.gradle/
app/android/.gradle/
app/android/.kotlin/
app/android/local.properties
app/.flutter-plugins
app/.flutter-plugins-dependencies
*.iml
build_apk_debug.log
app/android/hs_err_pid*.log

# --- never: local icon-review image (generated by make_app_icon.py) ---
app_icon_preview.png
